#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Вызов вашего общего модуля для программного создания элементов (поля скидки и кнопки)
	net_РаботаСФормами.ДополнитьФорму(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	РассчитатьСуммуДокумента();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУслуги

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УслугиЦенаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриИзменении(Элемент)
	РассчитатьСуммуДокумента();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Доработка: учет согласованной скидки в строках табличной части
&НаКлиенте
&ИзменениеИКонтроль("РассчитатьСуммуСтроки")
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
    
    // Типовой код закомментирован:
    // КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
    // ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
    
    // Ваш новый код:
    Скидка = Объект.СогласованнаяСкидка;
    БазоваяСумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
    ТекущиеДанные.Сумма = Окр(БазоваяСумма * (100 - Скидка) / 100, 2);
    
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуДокумента()
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
КонецПроцедуры

// Доработка: команда и процедура для применения скидки ко всем строкам
&НаКлиенте
Процедура ПересчитатьСкидку(Команда)
	
	Если Объект.Товары.Количество() = 0 И Объект.Услуги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Ответ = ВопросАсинх("Применить скидку ко всем строкам табличной части?", РежимДиалогаВопрос.ДаНет, 0);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПересчитатьСкидкуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСкидкуНаСервере()
	
	// Применяем скидку ко всем строкам табличной части Товары
	Для Каждого Строка Из Объект.Товары Цикл
		Скидка = Объект.СогласованнаяСкидка;
		БазоваяСумма = Строка.Цена * Строка.Количество;
		Строка.Сумма = Окр(БазоваяСумма * (100 - Скидка) / 100, 2);
	КонецЦикла;
	
	// Применяем скидку ко всем строкам табличной части Услуги
	Для Каждого Строка Из Объект.Услуги Цикл
		Скидка = Объект.СогласованнаяСкидка;
		БазоваяСумма = Строка.Цена * Строка.Количество;
		Строка.Сумма = Окр(БазоваяСумма * (100 - Скидка) / 100, 2);
	КонецЦикла;
	
	// Пересчитываем итог документа
	РассчитатьСуммуДокумента();
	
КонецПроцедуры

#КонецОбласти